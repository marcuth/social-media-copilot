<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="social-media-copilot.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Marcuth\Social Media Copilot">
    </Installer>
    <PackageInformation
        PackageName="Social Media Copilot"
        PackageDisplayName="Social Media Copilot"
        PublisherName="CN=Marcuth"
        PublisherDisplayName="Marcuth"
        Version="0.1.2.0"
        PackageDescription="Agendamento e criação de conteúdo para redes sociais com IA">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.marcuth.socialmediacopilot"
                Description="Agendamento e criação de conteúdo para redes sociais com IA"
                DisplayName="Social Media Copilot"
                ExecutableName="social-media-copilot.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Social Media Copilot</DisplayName>
            <PublisherDisplayName>Marcuth</PublisherDisplayName>
            <Description>Agendamento e criação de conteúdo para redes sociais com IA</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="social-media-copilot.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
