{
    "name": "social-media-copilot",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build:dev": "vue-tsc && vite build --minify false --mode development",
        "build": "vue-tsc && vite build --mode production",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "vue-tsc --noEmit",
        "ci": "npm run lint && npm run format:check && npm run typecheck"
    },
    "dependencies": {
        "@fontsource-variable/merriweather": "^5.3.0",
        "@fontsource-variable/nunito-sans": "^5.3.0",
        "@lucide/vue": "^1.72.0",
        "@tailwindcss/vite": "^4.3.5",
        "@vueuse/core": "^15.0.0",
        "@wailsio/runtime": "3.1.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "dompurify": "^3.4.17",
        "marked": "^18.2.0",
        "reka-ui": "^2.11.0",
        "simple-icons": "^16.37.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.2.45",
        "vue-router": "^4.6.4",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "^17.14.0",
        "prettier": "^3.10.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.2.4",
        "vue-tsc": "^3.3.12"
    }
}
